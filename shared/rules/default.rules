prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$target = Resolve-Path .\\.codex-build; $workspace = Resolve-Path .; if ($target.Path.StartsWith($workspace.Path)) { Remove-Item -LiteralPath $target.Path -Recurse -Force; Write-Output \"removed $($target.Path)\" } else { throw \"Refusing to remove outside workspace: $($target.Path)\" }"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["Remove-Item", "-LiteralPath", "C:\\Pond\\Bizinfo\\PlanNET2026\\.codex\\build-check", "-Recurse", "-Force"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$outDir = Join-Path $env:TEMP 'plannet-bridge-build-check'; if (Test-Path -LiteralPath $outDir) { Remove-Item -LiteralPath $outDir -Recurse -Force }"], decision="allow")
prefix_rule(pattern=["node", "--env-file=.env.local"], decision="allow")
prefix_rule(pattern=["npx.cmd", "supabase"], decision="allow")
prefix_rule(pattern=["npm.cmd", "install"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$databaseLine = Get-Content .env.local | Where-Object { $_ -match '^DATABASE_URL=' } | Select-Object -First 1; $env:DATABASE_URL = $databaseLine.Substring('DATABASE_URL='.Length).Trim().Trim('\"'); npx.cmd supabase db push --db-url $env:DATABASE_URL --include-all"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$line = Get-Content .env.local | Where-Object { $_ -match '^DATABASE_URL=' } | Select-Object -First 1; $env:DATABASE_URL = $line.Substring(13).Trim().Trim('\"'); npx.cmd supabase db lint --db-url $env:DATABASE_URL --schema public --level error --fail-on error"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$line = Get-Content .env.local | Where-Object { $_ -match '^DATABASE_URL=' } | Select-Object -First 1; if (-not $line) { throw 'DATABASE_URL not found' }; $dbUrl = $line.Substring('DATABASE_URL='.Length).Trim('\"'); npx.cmd supabase db push --db-url $dbUrl --yes"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$line = Get-Content .env.local | Where-Object { $_ -match '^DATABASE_URL=' } | Select-Object -First 1; if (-not $line) { throw 'DATABASE_URL missing' }; $dbUrl = $line.Substring('DATABASE_URL='.Length).Trim(); npx.cmd supabase db push --db-url $dbUrl --yes"], decision="allow")
